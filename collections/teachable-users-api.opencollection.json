{
  "opencollection": "1.0.0",
  "info": {
    "name": "Teachable Admin Courses Users API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apiKey",
      "value": "{{apiKey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://developers.teachable.com/v1/users",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Used in pagination when number of users exceed the maximum amount of results per page."
              },
              {
                "name": "per",
                "value": "",
                "type": "query",
                "description": "Used in pagination to define amount of users per page, when not defined the maximum is 20."
              },
              {
                "name": "email",
                "value": "",
                "type": "query",
                "description": "Filter users by user email."
              },
              {
                "name": "search_after",
                "value": "",
                "type": "query",
                "description": "Used when number of users exceeds 10,000 records. Use the search_after value to search the next set of records."
              }
            ]
          },
          "docs": "Get a list of users."
        },
        {
          "info": {
            "name": "Create a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://developers.teachable.com/v1/users",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new user on the school."
        },
        {
          "info": {
            "name": "Get a user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://developers.teachable.com/v1/users/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "The unique ID of the user."
              }
            ]
          },
          "docs": "Return a user by their unique ID."
        },
        {
          "info": {
            "name": "Update a user",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://developers.teachable.com/v1/users/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "The unique ID of the user."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the name or src of a user."
        }
      ]
    }
  ],
  "bundled": true
}