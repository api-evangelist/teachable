          "item": [
            {
              "name": "Get current user profile",
              "id": "28259eea-8bb7-4192-91d2-4eb49f340aa4",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "auth": {
                  "type": "oauth2",
                  "oauth2": [
                    {
                      "key": "scope",
                      "value": "name:read email:read courses:read courses:update",
                      "type": "string"
                    },
                    {
                      "key": "accessTokenUrl",
                      "value": "https://developers.teachable.com/oauth/token",
                      "type": "string"
                    },
                    {
