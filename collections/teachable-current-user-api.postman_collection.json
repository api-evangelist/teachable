                      "type": "string"
                    },
                    {
                      "key": "grant_type",
                      "value": "authorization_code",
                      "type": "string"
                    }
                  ]
                },
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/current_user/me",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "current_user",
                    "me"
                  ]
                },
                "description": "Retrieve the current authenticated user's profile information including name, email, and assigned role."
              },
